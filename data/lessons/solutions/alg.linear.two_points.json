{
  "concept": "alg.linear.two_points",
  "setup": "The line passes through \\(([[x1]], [[y1]])\\) and \\(([[x2]], [[y2]])\\).",
  "steps": [
    {
      "fact": "m",
      "say": "The slope is \\(\\frac{[[y2]]-[[y1]]}{[[x2]]-[[x1]]} = \\frac{[[dy]]}{[[dx]]} = [[m]]\\)."
